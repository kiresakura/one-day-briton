{
  "name": "one-day-briton",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node scripts/data-check.mjs && node --test \"test/unit/*.test.js\"",
    "test:sync": "scripts/with-java.sh firebase emulators:exec --only auth,database --project demo-one-day-briton \"node --test --test-force-exit test/sync/*.test.js\"",
    "test:all": "npm test && npm run test:sync",
    "data:check": "node scripts/data-check.mjs",
    "fonts:check": "node scripts/fonts/check.mjs",
    "data:import": "node scripts/data-import.mjs",
    "dev": "scripts/with-java.sh firebase emulators:start --only auth,database,hosting --project demo-one-day-briton",
    "bots": "node scripts/bots/cli.mjs",
    "vendor": "node scripts/vendor-firebase.mjs"
  },
  "devDependencies": {
    "firebase": "13.0.0",
    "firebase-tools": "15.33.0"
  }
}
