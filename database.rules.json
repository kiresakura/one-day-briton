{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".validate": "$code.matches(/^[A-HJKMNP-Z2-9]{6}$/)",
        "meta": {
          ".write": "auth != null && !data.exists() && newData.child('hostUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['hostUid', 'createdAt', 'tableCount'])",
          "hostUid": { ".validate": "newData.val() === auth.uid" },
          "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
          "tableCount": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 6"
          },
          "$other": { ".validate": false }
        },
        "tables": {
          ".write": "auth != null && (newData.parent().child('meta/hostUid').val() === auth.uid || root.child('rooms').child($code).child('hosts').child(auth.uid).val() === true)",
          "$table": {
            ".validate": "$table.matches(/^[1-6]$/) && newData.hasChildren(['round', 'phase', 'fog', 'updatedAt'])",
            "round": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1" },
            "phase": { ".validate": "newData.isString() && newData.val().matches(/^(sunrise|day|dusk|night)$/)" },
            "fog": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
            "updatedAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('meta').exists()",
            ".validate": "newData.hasChildren(['name', 'table', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
            },
            "table": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= root.child('rooms').child($code).child('meta/tableCount').val()"
            },
            "joinedAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        },
        "hosts": {
          "$uid": {
            ".write": "auth != null && (root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid || root.child('rooms').child($code).child('hosts').child(auth.uid).val() === true)",
            ".validate": "newData.val() === true"
          }
        },
        "hostRequests": {
          "$uid": {
            ".write": "auth != null && root.child('rooms').child($code).child('meta').exists() && (auth.uid === $uid || (!newData.exists() && (root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid || root.child('rooms').child($code).child('hosts').child(auth.uid).val() === true)))",
            ".validate": "newData.hasChildren(['requestedAt'])",
            "requestedAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('meta').exists()",
            ".validate": "newData.val() === true"
          }
        },
        "games": {
          "$table": {
            ".write": "auth != null && newData.exists() && (root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid || root.child('rooms').child($code).child('hosts').child(auth.uid).val() === true)",
            ".validate": "$table.matches(/^[1-6]$/) && newData.hasChildren(['startedAt', 'seats', 'deckCount', 'discardCount']) && newData.parent().parent().child('tables').child($table).exists() && newData.parent().parent().child('deals').child($table).exists() && ((!data.child('version').exists() && newData.child('version').val() === 1) || newData.child('version').val() === data.child('version').val() + 1)",
            "startedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now && (!data.exists() || newData.val() === data.val())"
            },
            "seats": {
              ".validate": "newData.hasChildren()",
              "$uid": {
                ".validate": "newData.hasChildren(['order', 'role', 'pounds', 'influence', 'handCount'])",
                "order": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 5"
                },
                "role": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,32}$/)" },
                "pounds": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
                "influence": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
                "handCount": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
                "sin": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
                "$other": { ".validate": false }
              }
            },
            "deckCount": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "discardCount": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
            "version": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1" },
            "startOrder": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 5 && (newData.val() === data.val() || (!data.parent().child('turn').exists() && !data.parent().child('pending').exists()))"
            },
            "pending": {
              ".validate": "newData.hasChildren(['id', 'by', 'seq', 'card', 'level', 'openedAt', 'seconds']) && (!data.exists() || newData.child('id').val() === data.child('id').val())",
              "id": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,40}$/)" },
              "by": {
                ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,128}$/) && newData.parent().parent().child('seats').child(newData.val()).exists()"
              },
              "seq": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1" },
              "card": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,32}$/)" },
              "level": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1" },
              "target": {
                ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,128}$/) && newData.parent().parent().child('seats').child(newData.val()).exists()"
              },
              "chainTarget": {
                ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,128}$/) && newData.parent().parent().child('seats').child(newData.val()).exists()"
              },
              "openedAt": { ".validate": "newData.isNumber() && newData.val() === now" },
              "seconds": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 60" },
              "$other": { ".validate": false }
            },
            "turn": {
              ".validate": "newData.hasChildren(['round', 'index', 'plays', 'level'])",
              "round": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1" },
              "index": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 6" },
              "plays": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
              "gear": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 32" },
              "level": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0" },
              "$other": { ".validate": false }
            },
            "fogMax": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 100" },
            "fogFired": {
              ".validate": "newData.hasChildren()",
              "$index": {
                ".validate": "$index.matches(/^(0|[1-9][0-9]*)$/) && newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 100"
              }
            },
            "fogPending": {
              ".validate": "newData.hasChildren()",
              "$index": {
                ".validate": "$index.matches(/^(0|[1-9][0-9]*)$/) && newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 100"
              }
            },
            "lastSeq": {
              "$uid": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && (!data.exists() || newData.val() >= data.val()) && newData.val() <= root.child('requests').child($code).child($uid).child('seq').val() && newData.parent().parent().child('seats').child($uid).exists()"
              }
            },
            "log": {
              "$id": {
                ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.hasChildren(['round', 'by', 'card', 'level', 'at']) && (!newData.hasChild('canceled') || newData.hasChild('response'))",
                "round": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1" },
                "by": {
                  ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,128}$/) && newData.parent().parent().parent().child('seats').child(newData.val()).exists()"
                },
                "card": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,32}$/)" },
                "level": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1" },
                "target": {
                  ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,128}$/) && newData.parent().parent().parent().child('seats').child(newData.val()).exists()"
                },
                "chainTarget": {
                  ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,128}$/) && newData.parent().parent().parent().child('seats').child(newData.val()).exists()"
                },
                "response": {
                  ".validate": "newData.hasChildren(['by', 'card'])",
                  "by": {
                    ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,128}$/) && newData.val() !== newData.parent().parent().child('by').val() && newData.parent().parent().parent().parent().child('seats').child(newData.val()).exists()"
                  },
                  "card": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,32}$/)" },
                  "$other": { ".validate": false }
                },
                "canceled": { ".validate": "newData.val() === true" },
                "at": { ".validate": "newData.isNumber() && newData.val() <= now" },
                "$other": { ".validate": false }
              }
            },
            "$other": { ".validate": false }
          }
        },
        "deals": {
          "$table": {
            ".write": "auth != null && newData.exists() && (root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid || root.child('rooms').child($code).child('hosts').child(auth.uid).val() === true)",
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && (!data.exists() || newData.val() > data.val()) && newData.val() === root.child('rooms').child($code).child('tables').child($table).child('round').val() && newData.parent().parent().child('games').child($table).exists()"
          }
        },
        "$other": { ".validate": false }
      }
    },
    "private": {
      "$code": {
        ".read": "auth != null && (root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid || root.child('rooms').child($code).child('hosts').child(auth.uid).val() === true)",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && (root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid || root.child('rooms').child($code).child('hosts').child(auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['table'])",
          "table": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= root.child('rooms').child($code).child('meta/tableCount').val()"
          },
          "hand": {
            ".validate": "newData.hasChildren()",
            "$index": {
              ".validate": "$index.matches(/^(0|[1-9][0-9]*)$/) && newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,32}$/)"
            }
          },
          "destiny": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,32}$/)" },
          "notice": {
            ".validate": "newData.hasChildren(['seq', 'reason'])",
            "seq": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1" },
            "reason": { ".validate": "newData.isString() && newData.val().matches(/^[a-z-]{1,40}$/)" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        }
      }
    },
    "requests": {
      "$code": {
        ".read": "auth != null && (root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid || root.child('rooms').child($code).child('hosts').child(auth.uid).val() === true)",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && newData.exists() && root.child('rooms').child($code).child('meta').exists()",
          ".validate": "newData.hasChildren(['seq', 'type', 'at']) && (!data.exists() || newData.child('seq').val() > data.child('seq').val()) && (newData.child('type').val() === 'pass' || newData.hasChild('card')) && (newData.child('type').val() !== 'respond' || newData.hasChild('pending'))",
          "seq": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1" },
          "type": { ".validate": "newData.isString() && newData.val().matches(/^(play|pass|respond)$/)" },
          "card": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,32}$/)" },
          "target": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,128}$/)" },
          "chainTarget": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,128}$/)" },
          "pending": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.parent().child('type').val() === 'respond'"
          },
          "at": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },
    "hostOnly": {
      "$code": {
        ".read": "auth != null && (root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid || root.child('rooms').child($code).child('hosts').child(auth.uid).val() === true)",
        ".write": "auth != null && (root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid || root.child('rooms').child($code).child('hosts').child(auth.uid).val() === true)",
        "$table": {
          ".validate": "$table.matches(/^[1-6]$/)",
          "deck": {
            ".validate": "newData.hasChildren()",
            "$index": {
              ".validate": "$index.matches(/^(0|[1-9][0-9]*)$/) && newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,32}$/)"
            }
          },
          "discard": {
            ".validate": "newData.hasChildren()",
            "$index": {
              ".validate": "$index.matches(/^(0|[1-9][0-9]*)$/) && newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,32}$/)"
            }
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
